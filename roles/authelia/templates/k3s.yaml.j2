# app: authelia (the installer removes this file when the app is removed)
# Authelia on k3s. Its config and users file stay on the first manager, like with Swarm. Made by ansibro.
apiVersion: apps/v1
kind: Deployment
metadata: { name: authelia, namespace: ansibro }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: authelia } }
  template:
    metadata:
      labels: { app: authelia }
      # Changes when the config changes, so Authelia restarts and reads it.
      annotations: { ansibro/config: "{{ authelia_config.checksum }}" }
    spec:
      nodeSelector: { kubernetes.io/hostname: {{ swarm_leader }} }
      containers:
        - name: authelia
          image: {{ registry_addr }}/authelia:{{ images.authelia.tag }}
          ports: [{ containerPort: 9091 }]
          volumeMounts: [{ name: config, mountPath: /config }]
      volumes:
        - { name: config, hostPath: { path: "{{ authelia_dir }}/config" } }
---
apiVersion: v1
kind: Service
metadata: { name: authelia, namespace: ansibro }
spec:
  selector: { app: authelia }
  ports: [{ port: 9091 }]
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata: { name: authelia, namespace: ansibro }
spec:
  entryPoints: [websecure]
  routes:
    - match: Host(`{{ authelia_host }}`)
      kind: Rule
      services: [{ name: authelia, port: 9091 }]
  tls: {}

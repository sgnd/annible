server:
  address: tcp://0.0.0.0:9091

log:
  level: info

identity_validation:
  reset_password:
    jwt_secret: {{ authelia_jwt_secret }}

# Users and password hashes. Edit users.yml to add users.
authentication_backend:
  file:
    path: /config/users.yml

access_control:
  default_policy: one_factor
  rules:
    # Admin pages need a second factor too (an authenticator app). The first time, Authelia asks
    # for a code that it writes to config/notification.txt in its folder on the first manager.
    - domain:
{% for name in authelia_admin_hosts %}
        - "{{ name }}.{{ domain }}"
{% endfor %}
      policy: two_factor

session:
  secret: {{ authelia_session_secret }}
  cookies:
    - domain: {{ domain }}
      authelia_url: https://{{ authelia_host }}
  redis:
{% if cache_ha %}
    # Ask Sentinel where the primary is, so a failover does not break the logins.
    host: {{ cache_ip }}
    port: 26379
    high_availability:
      sentinel_name: ansibro
      sentinel_password: {{ cache_password }}
      nodes:
{% for host in app_nodes[cache_app][1:] %}
        - { host: {{ hostvars[host].node_ip }}, port: 26379 }
{% endfor %}
{% else %}
    host: {{ cache_ip }}
    port: 6379
{% endif %}
    password: {{ cache_password }}

storage:
  encryption_key: {{ authelia_storage_key }}
{% if database_app == 'postgres' %}
  postgres:
    address: tcp://{{ database_host }}:5432
{% else %}
  mysql:
    address: tcp://{{ database_host }}:3306
{% endif %}
    database: authelia
    username: authelia
    password: {{ authelia_db_password }}

# No email server: password reset links are written to this file.
notifier:
  filesystem:
    filename: /config/notification.txt

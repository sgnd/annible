# OpenBao settings. Made by ansibro, do not change it here.
ui = true
disable_mlock = true  # not needed with integrated storage (raft)

storage "raft" {
  path    = "/openbao/file"
  node_id = "{{ inventory_hostname }}"
}

# Plain HTTP on the cluster network; https://openbao.<domain> goes through Traefik.
listener "tcp" {
  address         = "{{ node_ip }}:8200"
  cluster_address = "{{ node_ip }}:8201"
  tls_disable     = true
}

api_addr     = "http://{{ node_ip }}:8200"
cluster_addr = "http://{{ node_ip }}:8201"

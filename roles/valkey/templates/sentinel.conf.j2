# Sentinel for Valkey. Made by ansibro the first time; after that Sentinel keeps it up to date itself.
port 26379
sentinel announce-ip {{ node_ip }}
requirepass {{ valkey_password }}
sentinel monitor ansibro {{ valkey_primary_ip }} 6379 {{ valkey_quorum }}
sentinel auth-pass ansibro {{ valkey_password }}
sentinel down-after-milliseconds ansibro 5000
sentinel failover-timeout ansibro 60000

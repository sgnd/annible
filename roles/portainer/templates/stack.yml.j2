services:
  agent:
    image: {{ registry_addr }}/portainer-agent:{{ images['portainer-agent'].tag }}
    environment:
      AGENT_SECRET: {{ portainer_agent_secret }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - agent
    deploy:
      mode: global
      placement:
        constraints:
          - node.platform.os == linux

  portainer:
    image: {{ registry_addr }}/portainer:{{ images.portainer.tag }}
    command: -H tcp://tasks.agent:9001 --tlsskipverify --admin-password-file /run/admin_password
    environment:
      AGENT_SECRET: {{ portainer_agent_secret }}
    volumes:
      - {{ portainer_dir }}/data:/data
      - {{ portainer_dir }}/admin_password:/run/admin_password:ro
    networks:
      - agent
      - public
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}
      labels:
        traefik.enable: "true"
        traefik.http.routers.portainer.rule: Host(`{{ portainer_host }}`)
        traefik.http.routers.portainer.middlewares: admin-ip@file
        traefik.http.services.portainer.loadbalancer.server.port: "9000"

networks:
  agent:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "{{ swarm_mtu }}"
  public:
    external: true

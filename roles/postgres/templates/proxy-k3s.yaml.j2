# app: postgres (the installer removes this file when the app is removed)
# postgres-proxy on k3s: cluster apps connect to postgres-proxy.ansibro.svc.cluster.local:5432. Made by ansibro.
apiVersion: v1
kind: ConfigMap
metadata: { name: postgres-proxy, namespace: ansibro }
data:
  haproxy.cfg: |
    {{ lookup('ansible.builtin.template', 'haproxy.cfg.j2') | indent(4) }}
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: postgres-proxy, namespace: ansibro }
spec:
  replicas: 2
  selector: { matchLabels: { app: postgres-proxy } }
  template:
    metadata:
      labels: { app: postgres-proxy }
      annotations: { ansibro/config: "{{ postgres_proxy_config.checksum }}" }
    spec:
      containers:
        - name: haproxy
          image: {{ registry_addr }}/haproxy:{{ images.haproxy.tag }}
          ports: [{ containerPort: 5432 }]
          volumeMounts: [{ name: config, mountPath: /usr/local/etc/haproxy }]
      volumes:
        - { name: config, configMap: { name: postgres-proxy } }
---
apiVersion: v1
kind: Service
metadata: { name: postgres-proxy, namespace: ansibro }
spec:
  selector: { app: postgres-proxy }
  ports: [{ port: 5432 }]

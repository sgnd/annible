# Log agent on {{ inventory_hostname }}: sends the logs of every container and of the system
# to the monitoring server. Each log line gets the labels node, app and container.
data_dir: /var/lib/vector

sources:
  containers:
    type: docker_logs
  system:
    type: journald
    # First start: from now, not the whole old journal. Later: go on where it stopped.
    since_now: true
  vector_metrics:
    type: internal_metrics
{% if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] %}
  # k3s pods are not Docker containers: k3s writes their logs to files.
  pods:
    type: file
    include: [/var/log/pods/*/*/*.log]
{% endif %}

transforms:
  container_labels:
    type: remap
    inputs: [containers]
    source: |
      .node = "{{ inventory_hostname }}"
{% raw %}
      # app: the compose app or swarm stack. container: the service name, the same after a restart.
      .app = .label."com.docker.compose.project" || .label."com.docker.stack.namespace" || .container_name || "other"
      .container = .label."com.docker.swarm.service.name" || .container_name || "other"
{% endraw %}
{% if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] %}
  pod_labels:
    type: remap
    inputs: [pods]
    source: |
      .node = "{{ inventory_hostname }}"
{% raw %}
      # The file is /var/log/pods/<namespace>_<pod>_<id>/<container>/0.log: app and container are
      # the container's name. A line is "<time> stdout F <message>": keep the message only.
      parts = split(string(.file) ?? "", "/")
      .app = string(parts[5]) ?? "other"
      .container = .app
      .message = replace(string(.message) ?? "", r'^\S+ \S+ \S+ ', "")
{% endraw %}
{% endif %}
  system_labels:
    type: remap
    inputs: [system]
    source: |
      .node = "{{ inventory_hostname }}"
      .app = "system"
      .container = ._SYSTEMD_UNIT || .SYSLOG_IDENTIFIER || "kernel"

sinks:
  # Loki and VictoriaLogs both take logs in the Loki format.
  logs:
    type: loki
    inputs: [container_labels, system_labels{{ ', pod_labels' if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] }}]
{% if monitoring_app == 'prometheus' %}
    endpoint: http://{{ monitoring_ip }}:{{ observability_logs_port }}
{% else %}
    endpoint: http://{{ monitoring_ip }}:{{ observability_logs_port }}/insert
{% endif %}
    encoding:
      codec: text
    labels:
{% raw %}
      node: "{{ node }}"
      app: "{{ app }}"
      container: "{{ container }}"
{% endraw %}
    out_of_order_action: accept
    # While the monitoring server is down, keep up to 1 GB of logs on disk and send them later.
    buffer:
      type: disk
      max_size: 1073741824
      when_full: drop_newest

  # The monitoring server checks that this agent works (LogsNotSent alert).
  metrics:
    type: prometheus_exporter
    inputs: [vector_metrics]
    address: {{ node_ip }}:{{ observability_vector_port }}

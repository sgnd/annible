# Host network: the firewall decides who can connect. Every app listens on {{ node_ip }} only.
services:
{% if monitoring_app == 'prometheus' %}
  # Collects the metrics of every server and checks the alert rules.
  prometheus:
    image: {{ registry_addr }}/prometheus:{{ images.prometheus.tag }}
    container_name: prometheus
    restart: always
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ observability_keep_days }}d
      - --web.listen-address={{ node_ip }}:{{ observability_metrics_port }}
      - --web.external-url=https://metrics.{{ domain }}
    volumes:
      - ./config/scrape.yml:/etc/prometheus/prometheus.yml:ro
      - ./config/alerts.yml:/etc/prometheus/alerts.yml:ro
      - ./data/metrics:/prometheus

  # Keeps the logs that the agents send.
  loki:
    image: {{ registry_addr }}/loki:{{ images.loki.tag }}
    container_name: loki
    restart: always
    network_mode: host
    command: [-config.file=/etc/loki/loki.yml]
    volumes:
      - ./config/loki.yml:/etc/loki/loki.yml:ro
      - ./data/logs:/loki
{% else %}
  # Collects the metrics of every server.
  victoriametrics:
    image: {{ registry_addr }}/victoriametrics:{{ images.victoriametrics.tag }}
    container_name: victoriametrics
    restart: always
    network_mode: host
    command:
      - -storageDataPath=/storage
      - -retentionPeriod={{ observability_keep_days }}d
      - -httpListenAddr={{ node_ip }}:{{ observability_metrics_port }}
      - -promscrape.config=/etc/victoria/scrape.yml
    volumes:
      - ./config/scrape.yml:/etc/victoria/scrape.yml:ro
      - ./data/metrics:/storage

  # Keeps the logs that the agents send.
  victorialogs:
    image: {{ registry_addr }}/victorialogs:{{ images.victorialogs.tag }}
    container_name: victorialogs
    restart: always
    network_mode: host
    command:
      - -storageDataPath=/storage
      - -retentionPeriod={{ observability_keep_days }}d
      - -httpListenAddr={{ node_ip }}:{{ observability_logs_port }}
    volumes:
      - ./data/logs:/storage

  # Checks the alert rules against the metrics, and sends alerts to Alertmanager.
  vmalert:
    image: {{ registry_addr }}/vmalert:{{ images.vmalert.tag }}
    container_name: vmalert
    restart: always
    network_mode: host
    command:
      - -rule=/etc/vmalert/alerts.yml
      - -datasource.url=http://{{ node_ip }}:{{ observability_metrics_port }}
      # Saves the alert state, so a restart does not reset the "for" time of an alert.
      - -remoteWrite.url=http://{{ node_ip }}:{{ observability_metrics_port }}
      - -remoteRead.url=http://{{ node_ip }}:{{ observability_metrics_port }}
      - -notifier.url=http://{{ node_ip }}:{{ observability_alertmanager_port }}
      - -evaluationInterval=30s
      - -httpListenAddr={{ node_ip }}:{{ observability_vmalert_port }}
      - -external.url=https://grafana.{{ domain }}
    volumes:
      - ./config/alerts.yml:/etc/vmalert/alerts.yml:ro
{% endif %}

  # Sends the alerts to Telegram, email or a webhook, and the heartbeat to Uptime Kuma.
  alertmanager:
    image: {{ registry_addr }}/alertmanager:{{ images.alertmanager.tag }}
    container_name: alertmanager
    restart: always
    network_mode: host
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address={{ node_ip }}:{{ observability_alertmanager_port }}
      - --web.external-url=https://alertmanager.{{ domain }}
      - --cluster.listen-address=  # one Alertmanager, no cluster
    volumes:
      - ./config/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ./alertmanager:/alertmanager

  # Dashboards and log search.
  grafana:
    image: {{ registry_addr }}/grafana:{{ images.grafana.tag }}
    container_name: grafana
    restart: always
    network_mode: host
    env_file: .env
    environment:
      GF_SERVER_HTTP_ADDR: "{{ node_ip }}"
      GF_SERVER_HTTP_PORT: "{{ observability_grafana_port }}"
      GF_SERVER_ROOT_URL: https://grafana.{{ domain }}
      GF_SECURITY_ADMIN_USER: admin
      # Works offline: no update checks, no usage reports, no plugin downloads.
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
    volumes:
      - ./config/grafana:/etc/grafana/provisioning:ro
      - ./grafana:/var/lib/grafana

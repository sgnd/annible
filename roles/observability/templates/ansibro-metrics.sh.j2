#!/usr/bin/env bash
# Extra metrics for {{ inventory_hostname }}, for the alerts that node-exporter cannot see.
# Made by ansibro, do not change it here. Runs every minute (ansibro-metrics.timer).
# node-exporter reads the file it writes: /var/lib/ansibro-metrics/ansibro.prom
set -uo pipefail  # no -e: one failed check must not stop the others

out=/var/lib/ansibro-metrics/ansibro.prom
tmp=$(mktemp "$out.XXXXXX")

{
  # 1. Each server app on this server answers on its port.
{% for app in node_apps if app in observability_app_ports %}
  up=0; timeout 3 bash -c '</dev/tcp/{{ node_ip }}/{{ observability_app_ports[app] }}' 2>/dev/null && up=1
  echo "ansibro_app_up{app=\"{{ app }}\",port=\"{{ observability_app_ports[app] }}\"} $up"
{% endfor %}
{% if 'openbao' in node_apps %}
  # OpenBao answers, but can only give out secrets when it is unsealed.
  sealed=$(curl -s -m 3 http://{{ node_ip }}:8200/v1/sys/seal-status | jq -r 'if .sealed then 1 else 0 end' 2>/dev/null)
  echo "ansibro_openbao_sealed ${sealed:-1}"
{% endif %}

  # 2. Containers started with docker compose (server apps, agents): running, restarts, out of memory.
{% raw %}
  docker ps -aq --filter label=com.docker.compose.project | xargs -r docker inspect \
    -f '{{.Name}} {{.State.Running}} {{.RestartCount}} {{.State.OOMKilled}}' |
  while read -r name running restarts oom; do
    name=${name#/}
    echo "ansibro_container_running{container=\"$name\"} $([ "$running" = true ] && echo 1 || echo 0)"
    echo "ansibro_container_restarts_total{container=\"$name\"} $restarts"
    echo "ansibro_container_oom_killed{container=\"$name\"} $([ "$oom" = true ] && echo 1 || echo 0)"
  done
{% endraw %}
{% if inventory_hostname == swarm_leader and orchestrator == 'k3s' %}

  # 3. First manager (k3s): each server is ready, each deployment runs all its pods,
  # and how many pods are stuck (not running and not finished).
{% raw %}
  k3s kubectl get nodes --no-headers | while read -r node status _; do
    echo "ansibro_k3s_node_ready{k3s_node=\"$node\"} $([ "${status%%,*}" = Ready ] && echo 1 || echo 0)"
  done
  k3s kubectl get deployments -A --no-headers | while read -r namespace name ready _; do
    echo "ansibro_k3s_deployment_ready{namespace=\"$namespace\",deployment=\"$name\"} ${ready%/*}"
    echo "ansibro_k3s_deployment_desired{namespace=\"$namespace\",deployment=\"$name\"} ${ready#*/}"
  done
  echo "ansibro_k3s_pods_stuck $(k3s kubectl get pods -A --no-headers --field-selector=status.phase!=Running,status.phase!=Succeeded | wc -l)"
{% endraw %}
{% endif %}
{% if inventory_hostname == swarm_leader and orchestrator == 'swarm' %}

  # 3. First manager: each swarm service runs all its tasks, and each server is ready.
  # Replicas look like "1/1" or "2/3 (max 1 per node)": running/wanted.
{% raw %}
  docker service ls --format '{{.Name}} {{.Replicas}}' | while read -r service replicas _; do
    echo "ansibro_swarm_service_running{service=\"$service\"} ${replicas%/*}"
    echo "ansibro_swarm_service_desired{service=\"$service\"} ${replicas#*/}"
  done
  docker node ls --format '{{.Hostname}} {{.Status}}' | while read -r node status; do
    echo "ansibro_swarm_node_ready{swarm_node=\"$node\"} $([ "$status" = Ready ] && echo 1 || echo 0)"
  done
{% endraw %}
{% endif %}
{% if backup is defined %}

  # 4. Backup: when the last one worked (0 = never).
  echo "ansibro_backup_enabled 1"
  echo "ansibro_backup_last_success_timestamp_seconds $(cat {{ apps_dir }}/backup/last-success 2>/dev/null || echo 0)"
{% endif %}
{% if wireguard %}

  # 5. WireGuard: last handshake with each other server (0 = never). Peers renew it every 2 minutes.
  wg show wg0 dump | tail -n +2 | while read -r _ _ _ allowed handshake _; do
    echo "ansibro_wireguard_last_handshake_seconds{peer=\"${allowed%/32}\"} $handshake"
  done
{% endif %}

  # 6. System services that failed.
  echo "ansibro_systemd_failed_units $(systemctl list-units --state=failed --no-legend --plain | wc -l)"
} > "$tmp"

chmod 0644 "$tmp"
mv "$tmp" "$out"

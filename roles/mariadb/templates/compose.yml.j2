services:
  mariadb:
    image: {{ registry_addr }}/mariadb:{{ images.mariadb.tag }}
    container_name: mariadb
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    env_file: .env
    volumes:
      - ./data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

{
{% if inventory_hostname not in groups['swarm'] %}
  "live-restore": true,
{% endif %}
{# Docker Hub allows few downloads without a login: try Google's copy of it first. #}
{% if not offline %}
  "registry-mirrors": ["https://mirror.gcr.io"],
{% endif %}
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "{{ docker_log_max_size }}",
    "max-file": "{{ docker_log_max_file }}"
  }
}

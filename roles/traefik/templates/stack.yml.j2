services:
  traefik:
    image: {{ registry_addr }}/traefik:{{ images.traefik.tag }}
    # Host mode keeps the real client IP. Point DNS to {{ traefik_nodes | join(', ') }}.
    ports:
      - { target: 80, published: 80, protocol: tcp, mode: host }
      - { target: 443, published: 443, protocol: tcp, mode: host }
{% if monitoring_app %}
      - { target: 8082, published: 8082, protocol: tcp, mode: host }  # metrics, for the monitoring server
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ traefik_dir }}:/etc/traefik
    networks:
      - public
{% if 'kong' in apps %}
      - kong
{% endif %}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    deploy:
      mode: global  # one on each server below
      placement:
        constraints:
{% if traefik_nodes | length > 1 %}
          - node.role == manager
{% else %}
          - node.hostname == {{ swarm_leader }}
{% endif %}
      update_config:
        order: stop-first
      labels:
        traefik.enable: "true"
        traefik.http.routers.dashboard.rule: Host(`{{ traefik_host }}`)
        traefik.http.routers.dashboard.service: api@internal
        traefik.http.routers.dashboard.middlewares: admin@file
        traefik.http.services.dashboard.loadbalancer.server.port: "8080"

networks:
  public:
    external: true
{% if 'kong' in apps %}
  kong:
    external: true
{% endif %}

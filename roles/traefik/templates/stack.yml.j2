services:
  traefik:
    image: {{ registry_addr }}/traefik:{{ images.traefik.tag }}
    # Host mode keeps the real client IP. Point DNS to {{ swarm_leader }}.
    ports:
      - { target: 80, published: 80, protocol: tcp, mode: host }
      - { target: 443, published: 443, protocol: tcp, mode: host }
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ traefik_dir }}:/etc/traefik
    networks:
      - public
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}
      update_config:
        order: stop-first
      labels:
        traefik.enable: "true"
        traefik.http.routers.dashboard.rule: Host(`{{ traefik_host }}`)
        traefik.http.routers.dashboard.service: api@internal
        traefik.http.routers.dashboard.middlewares: admin@file
        traefik.http.services.dashboard.loadbalancer.server.port: "8080"

networks:
  public:
    external: true

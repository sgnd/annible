global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
{% if tls | default('letsencrypt') == 'letsencrypt' %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: {}
{% endif %}

providers:
  swarm:
    exposedByDefault: false
    network: public
  file:
    directory: /etc/traefik/dynamic
    watch: true

{% if tls | default('letsencrypt') == 'letsencrypt' %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ acme_email }}
      storage: /etc/traefik/acme/acme.json
      httpChallenge:
        entryPoint: web

{% endif %}
api:
  dashboard: true

ping: {}

log:
  level: {{ traefik_log_level }}

accessLog: {}

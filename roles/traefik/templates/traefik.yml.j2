global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
{% if tls | default('letsencrypt') == 'letsencrypt' %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: {}
{% endif %}

{% if monitoring_app %}
  # Only for the monitoring server (the firewall lets only the cluster servers in).
  metrics:
    address: ":8082"

{% endif %}
providers:
  swarm:
    exposedByDefault: false
    network: public
    refreshSeconds: 5   # how often Traefik looks for new swarm apps (default 15)
  file:
    directory: /etc/traefik/dynamic
    watch: true

{% if tls | default('letsencrypt') == 'letsencrypt' %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ acme_email }}
      storage: /etc/traefik/acme/acme.json
{% if acme_server is defined %}
      caServer: {{ acme_server }}
{% endif %}
{% if acme_ca_cert is defined %}
      caCertificates: [/etc/traefik/certs/acme-ca.pem]
{% endif %}
      httpChallenge:
        entryPoint: web

{% endif %}
api:
  dashboard: true

ping: {}
{% if monitoring_app %}

metrics:
  prometheus:
    entryPoint: metrics
{% endif %}

log:
  level: {{ traefik_log_level }}

accessLog: {}

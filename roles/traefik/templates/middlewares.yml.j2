# Use in app labels:
#   admin-ip@file  only allow admin_allow_from
#   admin@file     admin-ip plus a login: Authelia or Keycloak (both with a second factor) when
#                  installed (admin_sso), else the dashboard password
#   authelia@file  Authelia login (only when Authelia is installed)
http:
  middlewares:
    admin-ip:
      ipAllowList:
        sourceRange:
{# Empty admin_allow_from = allow everyone. #}
{% for cidr in (admin_allow_from | default([])) or ['0.0.0.0/0', '::/0'] %}
          - "{{ cidr }}"
{% endfor %}
    admin-auth:
      basicAuth:
        usersFile: /etc/traefik/users
    admin:
      chain:
        middlewares:
          - admin-ip
          - {{ {'authelia': 'authelia', 'keycloak': 'oauth'}[admin_sso] | default('admin-auth') }}
{% if 'authelia' in apps %}
    authelia:
      forwardAuth:
        address: http://authelia_authelia:9091/api/authz/forward-auth
        trustForwardHeader: true
        authResponseHeaders: [Remote-User, Remote-Groups, Remote-Email, Remote-Name]
{% endif %}
{% if admin_sso == 'keycloak' %}
    # Keycloak login through oauth2-proxy (in the keycloak stack).
    oauth:
      forwardAuth:
        address: http://keycloak_oauth2-proxy:4180/
        trustForwardHeader: true
        authResponseHeaders: [X-Auth-Request-User, X-Auth-Request-Email]
{% endif %}

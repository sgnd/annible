# Use in app labels:
#   admin-ip@file  only allow admin_allow_from
#   admin@file     admin-ip plus a login: the dashboard password, or Authelia (with a second
#                  factor) when Authelia is installed
#   authelia@file  Authelia login (only when Authelia is installed)
http:
  middlewares:
    admin-ip:
      ipAllowList:
        sourceRange:
{# Empty admin_allow_from = allow everyone. #}
{% for cidr in (admin_allow_from | default([])) or ['0.0.0.0/0', '::/0'] %}
          - "{{ cidr }}"
{% endfor %}
    admin-auth:
      basicAuth:
        usersFile: /etc/traefik/users
    admin:
      chain:
        middlewares:
          - admin-ip
          - {{ 'authelia' if 'authelia' in apps else 'admin-auth' }}
{% if 'authelia' in apps %}
    authelia:
      forwardAuth:
        address: http://authelia_authelia:9091/api/authz/forward-auth
        trustForwardHeader: true
        authResponseHeaders: [Remote-User, Remote-Groups, Remote-Email, Remote-Name]
{% endif %}
